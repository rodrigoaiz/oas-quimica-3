---
/**
 * Componente Breadcrumb - Navegación jerárquica
 * 
 * Props:
 * - items: Array<{ label: string, href?: string }>
 *   El último item (actual) no debe tener href
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumb-nav">
  <ol class="breadcrumb-list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumb-item">
          {!isLast && item.href ? (
            <>
              <a href={item.href} class="breadcrumb-link">
                {item.label}
              </a>
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
            </>
          ) : (
            <span class="breadcrumb-current" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb-nav {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    backdrop-filter: blur(4px);
  }

  :global(.dark) .breadcrumb-nav {
    background: rgba(30, 41, 59, 0.7);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
  }

  .breadcrumb-link {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s, text-decoration 0.2s;
  }

  :global(.dark) .breadcrumb-link {
    color: hsl(var(--color-primary-dark-h), var(--color-primary-dark-s), 65%);
  }

  .breadcrumb-link:hover {
    color: hsl(var(--color-primary-h), var(--color-primary-s), calc(var(--color-primary-l) - 10%));
    text-decoration: underline;
  }

  :global(.dark) .breadcrumb-link:hover {
    color: hsl(var(--color-primary-dark-h), var(--color-primary-dark-s), 70%);
  }

  .breadcrumb-link:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .breadcrumb-separator {
    color: #64748b;
    user-select: none;
    flex-shrink: 0;
  }

  :global(.dark) .breadcrumb-separator {
    color: #94a3b8;
  }

  .breadcrumb-current {
    color: #334155;
    font-weight: 600;
  }

  :global(.dark) .breadcrumb-current {
    color: #e2e8f0;
  }

  /* Mobile: texto más pequeño y anchos reducidos */
  @media (max-width: 640px) {
    .breadcrumb-nav {
      padding: 0.5rem 0.75rem;
    }
    .breadcrumb-list {
      font-size: 0.75rem;
      gap: 0.25rem;
    }
    .breadcrumb-item {
      gap: 0.25rem;
    }
    .breadcrumb-link {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 100px;
    }
    .breadcrumb-current {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 130px;
    }
  }
</style>
