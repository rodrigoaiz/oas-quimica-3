---
import LiteYouTubeWrapper from './LiteYouTubeWrapper.jsx';

export interface Props {
  videoId: string;
  title?: string;
  width?: string;
  autoplay?: boolean;
  nocookie?: boolean;
  className?: string;
  posterquality?: "default" | "mqdefault" | "hqdefault" | "sddefault" | "maxresdefault";
}

const { videoId, title = "YouTube video player", width = "w-full", autoplay = false, nocookie = true, className = "", posterquality = "hqdefault" } = Astro.props;
---

<div class={`${width} mx-auto ${className}`.trim()}>
  <LiteYouTubeWrapper 
    client:load
    videoId={videoId}
    title={title}
    autoplay={autoplay}
    nocookie={nocookie}
    posterquality={posterquality}
  />
  <p class="text-center text-sm text-gray-800 dark:text-gray-400">{title}</p>
</div>
