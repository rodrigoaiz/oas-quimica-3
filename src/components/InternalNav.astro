---
/**
 * Componente InternalNav - Navegación entre pantallas de un OA
 * 
 * Props:
 * - screens: Array<{ slug: string, title: string }>
 * - currentSlug: string
 * - baseUrl: string (ej: '/objetos/oa1')
 * - showIndex?: boolean (mostrar índice de todas las pantallas)
 * - compact?: boolean (versión compacta para parte superior)
 */

interface Screen {
  slug: string;
  title: string;
}

interface Props {
  screens: Screen[];
  currentSlug: string;
  baseUrl: string;
  showIndex?: boolean;
  compact?: boolean;
}

const { screens, currentSlug, baseUrl, showIndex = true, compact = false } = Astro.props;

const currentIndex = screens.findIndex(s => s.slug === currentSlug);
const prevScreen = currentIndex > 0 ? screens[currentIndex - 1] : null;
const nextScreen = currentIndex < screens.length - 1 ? screens[currentIndex + 1] : null;

// URLs para navegación
const prevUrl = prevScreen ? `${baseUrl}/${prevScreen.slug}` : null;
const nextUrl = nextScreen ? `${baseUrl}/${nextScreen.slug}` : null;
---

<nav 
  aria-label="Navegación interna del objeto de aprendizaje" 
  class:list={["internal-nav", { "compact": compact }]}
  data-prev-url={prevUrl}
  data-next-url={nextUrl}
>
  <!-- Skip link para accesibilidad -->
  <a href="#contenido" class="skip-link">Saltar a contenido</a>

  <!-- Navegación Prev/Next -->
  <div class="nav-controls" role="group" aria-label="Navegación entre pantallas">
    {prevScreen ? (
      <a 
        href={prevUrl} 
        class="nav-btn nav-prev"
        aria-label={`Anterior: ${prevScreen.title}`}
        {...(!compact && { accesskey: "p" })}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        {!compact && (
          <span class="nav-label">
            <span class="nav-label-sm" aria-hidden="true">Anterior</span>
            <span class="nav-label-lg">{prevScreen.title}</span>
          </span>
        )}
      </a>
    ) : (
      <div class="nav-btn-placeholder" aria-hidden="true"></div>
    )}

    {/* Indicador de posición en modo compacto */}
    {compact && (
      <span class="compact-position" aria-label={`Pantalla ${currentIndex + 1} de ${screens.length}`}>
        {currentIndex + 1} / {screens.length}
      </span>
    )}

    {nextScreen ? (
      <a 
        href={nextUrl} 
        class="nav-btn nav-next"
        aria-label={`Siguiente: ${nextScreen.title}`}
        {...(!compact && { accesskey: "n" })}
      >
        {!compact && (
          <span class="nav-label">
            <span class="nav-label-sm" aria-hidden="true">Siguiente</span>
            <span class="nav-label-lg">{nextScreen.title}</span>
          </span>
        )}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    ) : (
      <div class="nav-btn-placeholder" aria-hidden="true"></div>
    )}
  </div>

  <!-- Índice de pantallas (solo en modo normal) -->
  {!compact && showIndex && screens.length > 1 && (
    <details class="screen-index" open>
      <summary class="index-summary">
        Índice de pantallas ({currentIndex + 1}/{screens.length})
      </summary>
      <ol class="index-list">
        {screens.map((screen, idx) => (
          <li class:list={["index-item", { active: screen.slug === currentSlug }]}>
            {screen.slug === currentSlug ? (
              <span class="index-current" aria-current="page">
                {idx + 1}. {screen.title}
              </span>
            ) : (
              <a href={`${baseUrl}/${screen.slug}`} class="index-link">
                {idx + 1}. {screen.title}
              </a>
            )}
          </li>
        ))}
      </ol>
    </details>
  )}
</nav>

<style>
  .internal-nav {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid #e2e8f0;
  }

  /* Modo compacto para parte superior */
  .internal-nav.compact {
    margin-top: 0;
    padding: 0.5rem 1rem;
    border-top: none;
    border-bottom: 1px solid #e2e8f0;
    background: rgba(255, 255, 255, 0.95);
    position: sticky;
    top: 57px; /* Altura aproximada del Nav principal */
    z-index: 30;
    backdrop-filter: blur(8px);
  }

  :global(.dark) .internal-nav.compact {
    background: rgba(30, 41, 59, 0.95);
    border-bottom-color: #475569;
  }

  /* Controles Prev/Next */
  .nav-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .compact .nav-controls {
    margin-bottom: 0;
    gap: 0.75rem;
  }

  /* Indicador de posición en modo compacto */
  .compact-position {
    font-size: 0.875rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
  }

  :global(.dark) .compact-position {
    color: #94a3b8;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, hsl(var(--color-primary-h), var(--color-primary-s), calc(var(--color-primary-l) + 10%)) 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px hsl(var(--color-primary-h), var(--color-primary-s), var(--color-primary-l), 0.3);
    max-width: 45%;
  }

  .compact .nav-btn {
    padding: 0.375rem 0.625rem;
    min-width: 40px;
    max-width: none;
    border-radius: 6px;
    box-shadow: 0 1px 4px hsl(var(--color-primary-h), var(--color-primary-s), var(--color-primary-l), 0.2);
  }

  .nav-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px hsl(var(--color-primary-h), var(--color-primary-s), var(--color-primary-l), 0.4);
  }

  .compact .nav-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 6px hsl(var(--color-primary-h), var(--color-primary-s), var(--color-primary-l), 0.3);
  }

  .nav-btn:focus {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-prev {
    flex-direction: row;
  }

  .nav-next {
    flex-direction: row-reverse;
    text-align: right;
  }

  .compact .nav-next {
    text-align: left;
  }

  .nav-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-label-sm {
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .nav-label-lg {
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .nav-btn-placeholder {
    flex: 0 0 45%;
  }

  .compact .nav-btn-placeholder {
    flex: 0 0 40px;
  }

  /* Índice de pantallas */
  .screen-index {
    background: rgba(241, 245, 249, 0.8);
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 1rem;
  }

  .index-summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text-main);
    list-style: none;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .index-summary:hover {
    color: var(--color-primary);
  }

  .index-summary::marker,
  .index-summary::-webkit-details-marker {
    display: none;
  }

  .index-summary::before {
    content: '▶';
    display: inline-block;
    transition: transform 0.2s;
    font-size: 0.75rem;
  }

  details[open] .index-summary::before {
    transform: rotate(90deg);
  }

  .index-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .index-item {
    padding: 0.5rem;
    border-radius: 4px;
  }

  .index-item.active {
    background: rgba(0, 112, 243, 0.1);
    font-weight: 600;
  }

  .index-link {
    color: var(--color-primary);
    text-decoration: none;
    display: block;
    transition: color 0.2s;
  }

  .index-link:hover {
    color: hsl(var(--color-primary-h), var(--color-primary-s), calc(var(--color-primary-l) - 10%));
    text-decoration: underline;
  }

  .index-current {
    color: var(--color-text-main);
    display: block;
  }

  /* Mobile optimizations */
  @media (max-width: 640px) {
    .nav-controls {
      /* Mantener todo en una fila incluso en móvil */
      flex-direction: row;
      gap: 0.5rem;
    }

    .compact .nav-controls {
      gap: 0.5rem;
    }

    .nav-btn {
      /* En modo normal, permitir que crezcan */
      max-width: 45%;
      width: auto;
    }

    .compact .nav-btn {
      /* En modo compacto, mantener tamaño fijo */
      max-width: none;
      width: auto;
      padding: 0.375rem 0.5rem;
    }

    .nav-btn-placeholder {
      /* Mostrar placeholder en modo compacto para mantener simetría */
      display: block;
    }

    .compact .nav-btn-placeholder {
      flex: 0 0 40px;
    }

    .nav-label-lg {
      display: none;
    }

    .nav-label-sm {
      font-size: 0.875rem;
    }

    .compact-position {
      font-size: 0.75rem;
    }
  }

  /* Desktop: más espaciado */
  @media (min-width: 1024px) {
    .nav-controls {
      margin-bottom: 2rem;
    }

    .nav-btn {
      padding: 1rem 1.5rem;
    }
  }

  /* Skip link (solo visible al recibir foco) */
  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 999;
    padding: 1rem;
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    border-radius: 4px;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  /* Indicador de teclas de acceso */
  .nav-btn::after {
    content: attr(accesskey);
    position: absolute;
    bottom: 0.25rem;
    right: 0.25rem;
    font-size: 0.625rem;
    opacity: 0;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 0.125rem 0.25rem;
    border-radius: 2px;
    transition: opacity 0.2s;
  }

  .nav-btn:focus::after {
    opacity: 1;
  }

  /* Mejoras de contraste para accesibilidad */
  @media (prefers-contrast: high) {
    .nav-btn {
      border: 2px solid white;
    }
  }

  /* Reducir animaciones si el usuario lo prefiere */
  @media (prefers-reduced-motion: reduce) {
    .nav-btn,
    .index-summary::before,
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script is:inline>
  // Soporte de navegación por teclado - Reiniciar en cada carga de página
  (function() {
    // Función para configurar navegación
    function setupKeyboardNavigation() {
      // Buscar TODAS las instancias de InternalNav en la página
      const navElements = document.querySelectorAll('.internal-nav');
      if (navElements.length === 0) return;

      // Usar la primera instancia para obtener las URLs (ambas tienen los mismos datos)
      const firstNav = navElements[0];
      const prevUrl = firstNav.dataset.prevUrl;
      const nextUrl = firstNav.dataset.nextUrl;

      // Función para navegar
      const navigate = (url) => {
        if (url) {
          window.location.href = url;
        }
      };

      // Listener de teclado
      const handleKeyPress = (e) => {
        // Ignorar si el usuario está escribiendo en un input/textarea
        const target = e.target;
        if (target.tagName === 'INPUT' || 
            target.tagName === 'TEXTAREA' || 
            target.isContentEditable) {
          return;
        }

        // Navegación con flechas
        if (e.key === 'ArrowLeft' && prevUrl) {
          e.preventDefault();
          navigate(prevUrl);
        } else if (e.key === 'ArrowRight' && nextUrl) {
          e.preventDefault();
          navigate(nextUrl);
        }
        // Alt+Left = Anterior, Alt+Right = Siguiente (estilo navegador)
        else if (e.altKey && e.key === 'ArrowLeft' && prevUrl) {
          e.preventDefault();
          navigate(prevUrl);
        } else if (e.altKey && e.key === 'ArrowRight' && nextUrl) {
          e.preventDefault();
          navigate(nextUrl);
        }
        // Teclas P (Previous) y N (Next)
        else if ((e.key === 'p' || e.key === 'P') && prevUrl && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          navigate(prevUrl);
        } else if ((e.key === 'n' || e.key === 'N') && nextUrl && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          navigate(nextUrl);
        }
      };

      // Remover listener anterior si existe
      if (window.__internalNavHandler) {
        document.removeEventListener('keydown', window.__internalNavHandler);
      }

      // Guardar referencia al handler y agregarlo
      window.__internalNavHandler = handleKeyPress;
      document.addEventListener('keydown', handleKeyPress);

      // Anunciar atajos de teclado disponibles
      const shortcuts = [];
      if (prevUrl) shortcuts.push('Flecha izquierda o P para anterior');
      if (nextUrl) shortcuts.push('Flecha derecha o N para siguiente');
      
      if (shortcuts.length > 0) {
        console.log('📚', 'Atajos de teclado disponibles:', shortcuts.join(', '));
      }
    }

    // Ejecutar cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupKeyboardNavigation);
    } else {
      setupKeyboardNavigation();
    }

    // También ejecutar en eventos de navegación de Astro (si View Transitions están activas)
    document.addEventListener('astro:page-load', setupKeyboardNavigation);
  })();
</script>
