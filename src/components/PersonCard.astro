---
const { name } = Astro.props;
---

<div class="rounded-lg p-3 border border-(--color-primary)/20 dark:border-(--color-primary-dark)/30 bg-(--color-primary)/5 dark:bg-slate-800 hover:shadow-md transition-shadow">
  <p class="text-gray-800 dark:text-gray-100 font-medium text-center">{name}</p>
</div>
