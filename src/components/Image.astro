---
/**
 * Componente de imagen para contenido MDX
 * Encapsula el componente nativo de Astro con props convenientes
 *
 * Props:
 * - src: ImageMetadata (importación desde assets) o string (ruta a public)
 * - alt: string - Texto alternativo descriptivo
 * - caption?: string - Pie de foto opcional
 * - size?: 'sm' | 'md' | 'lg' | 'full' - Tamaño de la imagen
 * - rounded?: boolean - Bordes redondeados (default: true)
 * - shadow?: boolean - Sombra (default: true)
 * - class?: string - Clases adicionales
 */

import { Image as AstroImage } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  size?: "sm" | "md" | "lg" | "full";
  rounded?: boolean;
  shadow?: boolean;
  class?: string;
}

const { src, alt, caption, size = "md", rounded = true, shadow = true, class: className = "" } = Astro.props as Props;

// Mapear tamaños a clases de Tailwind
const sizeClasses: Record<"sm" | "md" | "lg" | "full", string> = {
  sm: "max-w-sm", // ~384px
  md: "max-w-xl", // ~672px
  lg: "max-w-2xl", // ~896px
  full: "w-full", // 100%
};

const roundedClass = rounded ? "rounded-xl" : "";
const shadowClass = shadow ? "shadow-lg" : "";

// Determinar si es una importación de assets o una ruta string
const isAsset = typeof src !== 'string';
---

<figure class={`my-8 ${sizeClasses[size]} mx-auto ${className}`}>
  {isAsset ? (
    <AstroImage 
      src={src}
      alt={alt}
      class={`w-full h-auto ${roundedClass} ${shadowClass} transition-transform duration-300 hover:scale-[1.02]`}
      loading="lazy"
    />
  ) : (
    <img 
      src={import.meta.env.BASE_URL.replace(/\/$/, '') + (src as string)}
      alt={alt}
      class={`w-full h-auto ${roundedClass} ${shadowClass} transition-transform duration-300 hover:scale-[1.02]`}
      loading="lazy"
    />
  )}
  {caption && (
    <figcaption class="mt-3 text-sm text-center text-slate-800 dark:text-slate-300" set:html={caption} />
  )}
</figure>
