---
/**
 * Componente para renderizar emojis usando Twemoji
 * Asegura que los emojis se vean igual en todos los navegadores/sistemas
 */
interface Props {
  symbol: string;
  label?: string;
  class?: string;
}

const { symbol, label, class: className = "" } = Astro.props;
---

<span 
  class={`emoji ${className}`} 
  role="img" 
  aria-label={label || symbol}
>
  {symbol}
</span>

<style>
  .emoji img.emoji {
    height: 1em;
    width: 1em;
    margin: 0 0.05em 0 0.1em;
    vertical-align: -0.1em;
    display: inline;
  }
</style>
