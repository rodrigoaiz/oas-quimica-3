---
const { title } = Astro.props;
---

<div class="bg-white dark:bg-slate-800 rounded-xl p-4 md:p-6 shadow-md border border-(--color-primary)/20 dark:border-slate-700 mb-6">
  <div class="flex items-center mb-4 text-center justify-center">
    <h2 class="text-xl md:text-2xl font-bold text-(--color-primary) dark:text-(--color-primary-dark)">{title}</h2>
  </div>
  <slot />
</div>
