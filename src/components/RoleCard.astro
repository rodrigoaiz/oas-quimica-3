---
const { icon, title, name } = Astro.props;
---

<div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-md border border-(--color-secondary)/20 dark:border-slate-700 hover:shadow-lg transition-shadow">
  <div class="text-center">
    <div class="w-12 h-12 bg-(--color-secondary)/10 dark:bg-(--color-secondary)/20 rounded-full flex items-center justify-center mx-auto mb-4">
      <span class="text-2xl">{icon}</span>
    </div>
    <h3 class="text-lg font-bold text-(--color-secondary) dark:text-accent mb-2">{title}</h3>
    <p class="text-gray-800 dark:text-gray-200 font-semibold">{name}</p>
  </div>
</div>
