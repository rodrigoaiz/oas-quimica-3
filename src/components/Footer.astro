---
import * as footerConfigModule from "@/config/footer.json";
import LogoPacch from "@/components/logos/logotipo-pacch-color-2024.svg";
import LogoUnam from "@/components/logos/logo-unam.svg";
import LogoCCH from "@/components/logos/logo-cch.svg";
import LogoElectronBlanco from "@/components/logos/logotipo-blanco.svg";
import LogoElectronAzul from "@/components/logos/logotipo-azul.svg";
import { Icon } from "astro-icon/components";
const footerConfig = footerConfigModule as {
  footer: Array<{ name: string; url: string }>;
  socials: Array<{ name: string; icon: string; link: string }>;
  copyright: string;
};

const { footer, socials, copyright } = footerConfig;
---

<footer class="bg-bg-main dark:bg-dark-bg-main mt-10 border-t dark:border-slate-700">
  <div class="container mx-auto max-w-5xl px-4">
    <div class="flex flex-col md:flex-row justify-around items-center py-10 gap-8">
      <!-- Logo y marcas -->
      <div class="text-center md:mb-0 md:text-left">
        <div class="w-full flex justify-center mb-6">
          <a href="/">
            <LogoElectronAzul class="hidden sm:block dark:hidden h-8" />
            <LogoElectronBlanco class="hidden sm:dark:block h-8" />
          </a>
        </div>
        <div class="grid grid-cols-3 gap-4 items-center justify-center justify-items-center">
          <a href="https://portalacademico.cch.unam.mx/" target="_blank" rel="noreferrer" aria-label="Portal Académico CCH">
            <LogoPacch class="h-7" />
          </a>
          <a href="https://www.unam.mx/" target="_blank" rel="noreferrer" aria-label="UNAM" class="logo-link">
            <LogoUnam class="h-10" />
          </a>
          <a href="https://cch.unam.mx/" target="_blank" rel="noreferrer" aria-label="CCH" class="logo-link">
            <LogoCCH class="h-10" />
          </a>
        </div>
      </div>

      <!-- Enlaces del footer -->
      <div class="text-center">
        <nav aria-label="Enlaces del footer">
          <ul class="flex flex-col md:flex-row gap-4">
            {
              footer.map((menu) => (
                <li>
                  <a class="text-slate-700 dark:text-slate-300 hover:text-(--color-primary) dark:hover:text-(--color-secondary) transition-all" href={menu.url}>
                    {menu.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Redes sociales -->
      <div class="text-center">
        <nav aria-label="Redes sociales">
          <ul class="flex gap-4 justify-center">
            {
              socials.map((social) => (
                <li>
                  <a
                    class="text-slate-700 dark:text-slate-300 hover:text-(--color-primary) dark:hover:text-(--color-secondary) transition-all text-xl"
                    href={social.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.name}>
                    <Icon name={social.icon} class="iconify" data-icon={social.icon} />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-slate-300 dark:border-slate-700 py-6">
    <div class="container max-w-5xl mx-auto px-4 text-center">
      <p class="text-sm text-slate-600 dark:text-slate-400" set:html={copyright} />
    </div>
  </div>
</footer>
