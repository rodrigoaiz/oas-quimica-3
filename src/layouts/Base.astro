---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import '@fontsource-variable/quicksand';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const { 
  title = 'Elctrón · Objetos de aprendizaje del CCH UNAM', 
  description = 'Portal de objetos de aprendizaje del Colegio de Ciencias y Humanidades de la UNAM, enfocado en la enseñanza de la química.', 
  keywords = 'CCH, UNAM, Química, Objetos de Aprendizaje, Recursos Educativos, Aprendizaje en Línea',
  noIndex = false 
} = Astro.props;
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Prevenir flash de modo incorrecto -->
    <script is:inline>
      // Este script debe ejecutarse ANTES de que el body se renderice
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" href={`${Astro.site?.pathname ?? '/'}favicon.svg`} />
  </head>
  <body class="bg-(--color-bg-main) dark:bg-slate-900 text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 bg-white dark:bg-slate-800 text-(--color-primary) dark:text-(--color-secondary) p-2 rounded">Saltar al contenido</a>
    <Nav current={Astro.url.pathname} />
    <slot />
    <Footer />
    
    <!-- Inicializar Twemoji después de que el DOM esté listo -->
    <script>
      import twemoji from 'twemoji';
      
      // Parsear emojis cuando el DOM esté listo
      document.addEventListener('DOMContentLoaded', () => {
        twemoji.parse(document.body, {
          folder: 'svg',
          ext: '.svg'
        });
      });
      
      // También parsear después de navegación (para SPAs/transiciones)
      document.addEventListener('astro:page-load', () => {
        twemoji.parse(document.body, {
          folder: 'svg',
          ext: '.svg'
        });
      });
    </script>
  </body>
</html>
