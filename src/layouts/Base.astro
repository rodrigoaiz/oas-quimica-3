---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import '@fontsource-variable/quicksand';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

const { 
  title = 'Electrón · Objetos de aprendizaje de la Asignatura de Química del CCH UNAM', 
  description = 'Electrón es un conjunto de Objetos de Aprendizaje (OA) diseñados para apoyar el estudio de la Química en el Colegio de Ciencias y Humanidades de la Universidad Nacional Autónoma de México. Estos recursos interactivos, desarrollados bajo el proyecto PAPIME PE210825 y alineados con el Programa de Estudios Ajustado 2024, ofrecen explicaciones claras, actividades prácticas, simulaciones y materiales multimedia que facilitan la comprensión de conceptos complejos. Finalmente, estos materiales incorporan una perspectiva de sostenibilidad y ciudadanía científica, conectando los contenidos de Química con los grandes desafíos actuales, como el uso responsable de la energía, la producción eficiente de recursos y el cuidado del ambiente.', 
  keywords = 'química, objetos de aprendizaje, educación, UNAM, CCH, sostenibilidad, ciudadanía científica',
  noIndex = false 
} = Astro.props;
---
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Prevenir flash de modo incorrecto -->
    <script is:inline>
      // Este script debe ejecutarse ANTES de que el body se renderice
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <link rel="icon" href={`${Astro.site?.pathname ?? '/'}favicon.svg`} />

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vxgl611zo4");
    </script>
  </head>
  <body class="bg-(--color-bg-main) dark:bg-dark-bg-main text-slate-900 dark:text-slate-100 transition-colors duration-200">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 bg-white dark:bg-slate-800 text-(--color-primary) dark:text-(--color-secondary) p-2 rounded">Saltar al contenido</a>
    <Nav current={Astro.url.pathname} />
    <slot />
    <Footer />
    
    <!-- Inicializar Twemoji después de que el DOM esté listo -->
    <script>
      import twemoji from 'twemoji';
      
      // Parsear emojis cuando el DOM esté listo
      document.addEventListener('DOMContentLoaded', () => {
        twemoji.parse(document.body, {
          folder: 'svg',
          ext: '.svg'
        });
      });
      
      // También parsear después de navegación (para SPAs/transiciones)
      document.addEventListener('astro:page-load', () => {
        twemoji.parse(document.body, {
          folder: 'svg',
          ext: '.svg'
        });
      });
    </script>
  </body>
</html>
