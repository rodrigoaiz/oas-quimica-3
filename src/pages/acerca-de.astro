---
import Base from "@/layouts/Base.astro";
import LogotipoElectronAzul from "@/components/logos/logotipo-azul.svg";
import Prose from "@/components/Prose.astro";
---

<Base title="Acerca de · Electrón">
  <Prose>
    <div class="prose my-10">
      <h1>Acerca de</h1>  
      <LogotipoElectronAzul class="w-2/3 h-auto mt-4" />
      <p class="text-5xl">Esta información falta por completar.</p>
      <p>
        Electrón es un conjunto de Objetos de Aprendizaje (OAs) diseñados para apoyar la enseñanza y el aprendizaje de la Química en el Colegio de Ciencias y Humanidades (CCH) de la Universidad Nacional Autónoma de México (UNAM). Estos recursos interactivos están alineados con el plan de estudios del CCH y buscan facilitar la comprensión de conceptos clave en Química a través de actividades prácticas y visuales.</p>
    </div>
  </Prose>    
</Base>
