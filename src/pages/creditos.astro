---
import Base from "@/layouts/Base.astro";
import PersonCard from "@/components/PersonCard.astro";
import RoleCard from "@/components/RoleCard.astro";
import Section from "@/components/Section.astro";
import OAHeader from "@/components/OAHeader.astro";
import Citation from "@/components/Citation.astro";
import CoordinationCard from "@/components/CoordinationCard.astro";
import Acknowledgments from "@/components/Acknowledgments.astro";
import Hr from "@/components/Hr.astro";
---

<Base title="Créditos · Electrón">
  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="prose mb-10">
      <h1>Créditos</h1>
    </div>
    <CoordinationCard />
  
    {/* Autores */}
    <Section title="Autoras y autores">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <PersonCard name="Maritza López Recillas" />
        <PersonCard name="Adriana Jaramillo Alcantar" />
        <PersonCard name="Sandra Guzmán Aguirre" />
        <PersonCard name="Guillermo Itzamna Platas Jiménez" />
        <PersonCard name="Gilberto Lira Vázquez" />
        <PersonCard name="Marina Lucía Morales Galicia" />
        <PersonCard name="Julio César Botello Pozos" />
        <PersonCard name="Juan Antonio Nicasio Collazo" />
        <PersonCard name="Jesús Medina Cabrera" />
      </div>
    </Section>
  
    {/* Equipo de Diseño */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <RoleCard icon="📚" title="Diseño Instruccional" name="Yadira Jannet Jiménez Taboada" />
  
      <RoleCard icon="⚙️" title="Diseño y desarrollo integral del sitio" name="Jesús Rodrigo Aizpuru Parra" />
  
      <RoleCard icon="🎨" title="Diseño web y coordinación editorial" name="Karla Gabriela Moreno Vega" />
    </div>
  
    {/* Agradecimientos */}
    <Acknowledgments />
  </section>

</Base>
