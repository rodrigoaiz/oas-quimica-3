---
import Base from "@/layouts/Base.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import InternalNav from "@/components/InternalNav.astro";
import ScreenIndex from "@/components/ScreenIndex.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const objetos = await getCollection("objetos");
  return objetos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;

// Obtener todas las pantallas de este OA
const allObjetos = await getCollection("objetos");
const screens = allObjetos
  .filter(
    (obj: CollectionEntry<"objetos">) =>
      obj.id.startsWith(`${entry.slug}/`) && obj.id !== `${entry.slug}.mdx`
  )
  .sort(
    (a: CollectionEntry<"objetos">, b: CollectionEntry<"objetos">) =>
      a.data.order - b.data.order
  )
  .map((screen: CollectionEntry<"objetos">) => ({
    slug: screen.id.replace(`${entry.slug}/`, "").replace(".mdx", ""),
    title: screen.data.title,
  }));

// Construir breadcrumbs
const breadcrumbItems = [
  { label: "Inicio", href: import.meta.env.BASE_URL || '/' },
  { label: data.title }, // último sin href (página actual)
];

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/objetos/${entry.slug}`;
---

<Base title={`${data.title} · Química 3`}>
  <main id="contenido" class="mx-auto max-w-6xl px-4 py-6">
    <!-- Breadcrumbs -->
    <Breadcrumb items={breadcrumbItems} />

    <header class="mb-6">
      <h1 class="text-4xl font-extrabold text-(--color-primary) dark:text-(--color-primary-dark) pt-2">{data.title}</h1>
      <img
        src={import.meta.env.BASE_URL.replace(/\/$/, '') + data.cover}
        alt={data.title}
        class="w-full aspect-video rounded-2xl mt-4 object-cover"
        loading="lazy"
      />
      
      {data.summary && (
        <div class="mt-10 pb-5 mx-auto max-w-3xl">
          <div class="relative bg-white dark:bg-slate-800 rounded-2xl p-6 border-2 border-(--color-primary)/30 dark:border-(--color-primary-dark)/40 shadow-lg hover:shadow-xl transition-shadow">
            <div class="absolute -top-5 left-6 bg-(--color-primary) dark:bg-(--color-primary-dark) rounded-full p-3 shadow-md">
              <span class="text-2xl select-none">🎯 Propósito</span>
            </div>
            <p class="text-gray-800 dark:text-gray-200 leading-relaxed text-base md:text-lg pt-6">
              {data.summary}
            </p>
          </div>
        </div>
      )}
      
    </header>

    <article class="contenido-mdx">
      <Content />
    </article>
    <!-- Índice de pantallas -->
    <ScreenIndex screens={screens} baseUrl={baseUrl} currentSlug="" />

    <!-- Navegación interna (solo mostrar si hay pantallas) -->
    {
      screens.length > 0 && (
        <InternalNav
          screens={screens}
          currentSlug=""
          baseUrl={baseUrl}
          showIndex={false}
        />
      )
    }
  </main>
</Base>
