---
/**
 * Página dinámica para pantallas individuales de un OA
 * Ruta: /objetos/[oaSlug]/[screenSlug]
 * 
 * Ejemplo: /objetos/oa1/introduccion
 * 
 * NOTA: Obtiene todo dinámicamente de la colección de contenido.
 * Para agregar una nueva pantalla, solo crea el archivo MDX en src/content/objetos/[oaSlug]/[screenSlug].mdx
 */
import OAScreen from '@/layouts/OAScreen.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  // Obtener todas las entradas de contenido
  const allObjetos = await getCollection('objetos');
  
  // Separar OAs principales de pantallas
  const mainOAs = allObjetos.filter((obj: CollectionEntry<'objetos'>) => !obj.id.includes('/'));
  const screenEntries = allObjetos.filter((obj: CollectionEntry<'objetos'>) => obj.id.includes('/'));
  
  const paths = [];
  
  // Para cada pantalla encontrada, generar su ruta
  for (const screenEntry of screenEntries) {
    // El id es algo como "oa1/introduccion.mdx", extraer partes
    const [oaSlug, screenFile] = screenEntry.id.split('/');
    const screenSlug = screenFile.replace('.mdx', '');
    
    // Buscar el OA principal para obtener su título
    const mainOA = mainOAs.find((oa: CollectionEntry<'objetos'>) => oa.id === `${oaSlug}.mdx`);
    
    if (!mainOA) {
      console.warn(`⚠️ No se encontró OA principal para: ${oaSlug}`);
      continue;
    }
    
    // Obtener todas las pantallas de este OA para la navegación
    const oaScreens = screenEntries
      .filter((entry: CollectionEntry<'objetos'>) => entry.id.startsWith(`${oaSlug}/`))
      .sort((a: CollectionEntry<'objetos'>, b: CollectionEntry<'objetos'>) => 
        a.data.order - b.data.order
      )
      .map((entry: CollectionEntry<'objetos'>) => ({
        slug: entry.id.replace(`${oaSlug}/`, '').replace('.mdx', ''),
        title: entry.data.title,
        order: entry.data.order
      }));
    
    paths.push({
      params: { 
        oaSlug, 
        screenSlug 
      },
      props: {
        oaTitle: mainOA.data.title,
        oaSlug,
        screenTitle: screenEntry.data.title,
        screenSlug,
        screens: oaScreens,
        entry: screenEntry,
      }
    });
  }

  return paths;
}

const { oaTitle, oaSlug, screenTitle, screenSlug, screens, entry } = Astro.props;
const pageTitle = `${screenTitle} · ${oaTitle} · Química 3`;

// Renderizar el contenido MDX
const { Content } = await entry.render();
---

<OAScreen
  title={pageTitle}
  oaTitle={oaTitle}
  oaSlug={oaSlug}
  screenTitle={screenTitle}
  screenSlug={screenSlug}
  screens={screens}
>
  <Content />
</OAScreen>
