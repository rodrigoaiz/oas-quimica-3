---
import Base from '@/layouts/Base.astro';
import HeroQuimico from '@/components/HeroQuimico.astro';
import BentoGrid from '@/components/BentoGrid.jsx';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Obtener todas las entradas de objetos
const allObjetos = await getCollection('objetos');

// Separar los OAs principales de las pantallas
// OAs principales: oa1.mdx, oa2.mdx, oa3.mdx (sin "/" en el ID)
// Pantallas: oa1/introduccion.mdx, oa1/dalton.mdx, etc. (con "/" en el ID)
const oasPrincipales = allObjetos.filter((obj: CollectionEntry<'objetos'>) => !obj.id.includes('/'));
const pantallas = allObjetos.filter((obj: CollectionEntry<'objetos'>) => obj.id.includes('/'));

// Crear un mapa de objetos para obtener títulos y portadas
const objetosMap: Record<string, { title: string; cover: string }> = {};
oasPrincipales.forEach((obj: CollectionEntry<'objetos'>) => {
  const slug = obj.id.replace('.mdx', ''); // "oa1.mdx" -> "oa1"
  objetosMap[slug] = {
    title: obj.data.title,
    cover: obj.data.cover
  };
});

// Preparar las pantallas para el BentoGrid
// Filtrar solo las que tengan oaSlug y screenSlug definidos
const screens = pantallas
  .filter((screen: CollectionEntry<'objetos'>) => screen.data.oaSlug && screen.data.screenSlug)
  .map((screen: CollectionEntry<'objetos'>) => ({
    oaSlug: screen.data.oaSlug!,
    oaTitle: objetosMap[screen.data.oaSlug!]?.title || screen.data.oaSlug!,
    oaCover: objetosMap[screen.data.oaSlug!]?.cover || '/images/cover-placeholder.jpg',
    screenSlug: screen.data.screenSlug!,
    screenTitle: screen.data.title,
    order: screen.data.order
  }));
---
<Base title="Química 3 · CCH – Objetos de aprendizaje">
  <HeroQuimico />
  <main id="contenido" class="mx-auto max-w-5xl px-4 py-10">
    <section id="objetos" aria-labelledby="objs">
      <div class="flex items-center justify-between mb-6">
        <h2 id="objs" class="text-2xl font-bold dark:text-slate-100">Explora los contenidos</h2>
        <a 
          href="/objetos/" 
          class="text-sm font-medium text-cch-azul dark:text-cch-dorado hover:underline flex items-center gap-1"
        >
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
      
      <p class="text-slate-700 dark:text-slate-300 mb-6">
        Esta es una selección aleatoria de algunas pantallas de los materiales de apoyo al aprendizaje. Cada vez que recargues la página verás contenidos diferentes.
      </p>

      <!-- Bento Grid con pantallas aleatorias (React Island) -->
      <BentoGrid screens={screens} client:load />
    </section>

    <section id="como-funciona" class="mt-16">
      <h2 class="text-2xl font-bold mb-4 dark:text-slate-100">Sobre este proyecto</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-blue-50 dark:bg-blue-950 border-2 border-blue-200 dark:border-blue-800 rounded-xl p-6">
          <div class="text-3xl mb-3">🎓</div>
          <h3 class="font-bold text-lg mb-2 dark:text-slate-100">Para estudiantes de CCH</h3>
          <p class="text-slate-700 dark:text-slate-300">
            Recursos educativos diseñados específicamente para el programa de Química III del Colegio de Ciencias y Humanidades de la UNAM.
          </p>
        </div>
        
        <div class="bg-purple-50 dark:bg-purple-950 border-2 border-purple-200 dark:border-purple-800 rounded-xl p-6">
          <div class="text-3xl mb-3">🧪</div>
          <h3 class="font-bold text-lg mb-2 dark:text-slate-100">Contenido estructurado</h3>
          <p class="text-slate-700 dark:text-slate-300">
            Cada objeto de aprendizaje está organizado en pantallas secuenciales que desarrollan los conceptos fundamentales de la química.
          </p>
        </div>
        
        <div class="bg-green-50 dark:bg-green-950 border-2 border-green-200 dark:border-green-800 rounded-xl p-6">
          <div class="text-3xl mb-3">✨</div>
          <h3 class="font-bold text-lg mb-2 dark:text-slate-100">Aprendizaje activo</h3>
          <p class="text-slate-700 dark:text-slate-300">
            Actividades interactivas, cuestionarios de autoevaluación y ejercicios prácticos para fortalecer tu comprensión de los temas.
          </p>
        </div>
        
        <div class="bg-orange-50 dark:bg-orange-950 border-2 border-orange-200 dark:border-orange-800 rounded-xl p-6">
          <div class="text-3xl mb-3">🌐</div>
          <h3 class="font-bold text-lg mb-2 dark:text-slate-100">Acceso libre</h3>
          <p class="text-slate-700 dark:text-slate-300">
            Material educativo abierto desarrollado por y para la comunidad universitaria. Disponible en cualquier momento y dispositivo.
          </p>
        </div>
      </div>
    </section>
  </main>
</Base>
